# ============================================================================
# pilot-quickstart.env — lean non-production Citadel Governance Hub overlay
# ============================================================================
#
# Use case: 1-2 day demo / PoC. Keep fixed-cost optional services off and use
# the simplest greenfield networking shape. APIM remains public for notebook
# access, but data-plane backends remain private.
#
# What you get:
#   - APIM Developer SKU (cheap, ~$50/mo, NO SLA, NOT for production)
#   - Public APIM gateway (api.azure-api.net) protected by subscription key
#     plus Entra JWT policy after the required post-deploy setup
#   - Greenfield VNet 10.170.0.0/24 + new private DNS zones in same RG
#   - Private backend access (Cosmos, Foundry, Key Vault, Event Hub)
#   - Core gateway APIs on (PII, model inference, realtime, unified-ai)
#   - Greenfield Log Analytics + 3 App Insights workspaces
#   - Redis, API Center, AI Search, Document Intelligence, and dashboards off
#   - Foundry network injection left at the upstream FALSE default. The pinned
#     main.bicepparam no longer consumes FOUNDRY_NETWORK_INJECTION_ENABLED.
#
# IMPORTANT: the upstream main.bicepparam still declares two Foundry instances
# and its full model deployment array. Structured arrays cannot be overridden
# safely through azd env vars. Review/reduce those two arrays in the pinned
# main.bicepparam before deployment if regional quota or model surface must be
# smaller. Model deployments are consumption-billed, but reserve TPM quota.
#
# Apply: see SKILL.md § 5 Path A
# ============================================================================

# --- Basics ---
AZURE_LOCATION=swedencentral
APIC_LOCATION=swedencentral

# --- APIM (Developer SKU = cheapest) ---
APIM_SKU=Developer
APIM_SKU_UNITS=1
APIM_NETWORK_TYPE=External
APIM_V2_USE_PRIVATE_ENDPOINT=false
APIM_V2_PUBLIC_NETWORK_ACCESS=true

# --- Networking: greenfield ---
USE_EXISTING_VNET=false
USE_EXISTING_LOG_ANALYTICS=false
VNET_ADDRESS_PREFIX=10.170.0.0/24

# --- Backend services: private; only APIM is internet-facing ---
COSMOS_DB_PUBLIC_ACCESS=Disabled
AI_FOUNDRY_EXTERNAL_NETWORK_ACCESS=Disabled
KEY_VAULT_EXTERNAL_NETWORK_ACCESS=Disabled
EVENTHUB_NETWORK_ACCESS=Disabled
REDIS_PUBLIC_NETWORK_ACCESS=Disabled

# --- Capacity (low) ---
COSMOS_DB_RUS=400
EVENTHUB_CAPACITY=1
LOGIC_APPS_SKU_CAPACITY_UNITS=1

# --- Feature flags: core gateway only; fixed-cost optional services off ---
ENABLE_PII_REDACTION=true
ENABLE_AI_MODEL_INFERENCE=true
ENABLE_OPENAI_REALTIME=true
ENABLE_UNIFIED_AI_API=true
ENABLE_MANAGED_REDIS=false
ENABLE_API_CENTER=false
ENABLE_AZURE_AI_SEARCH=false
ENABLE_DOCUMENT_INTELLIGENCE=false

# --- Auth: JWT policy enabled; run entra-id-setup/setup.ps1 after azd up ---
AZURE_ENTRA_AUTH=true

# --- Dashboards: skip (cuts cost; rebuild after deploy if needed) ---
CREATE_DASHBOARDS=false

# --- SKUs ---
APIC_SKU=Free
KEY_VAULT_SKU_NAME=standard
REDIS_SKU_NAME=Balanced_B1
REDIS_SKU_CAPACITY=1
REDIS_HIGH_AVAILABILITY=Disabled
