@@ -0,0 +1,325 @@
+#!/usr/bin/env python3
+"""Synchronous Docker isolation for the AgentOps child, not a native evaluator."""
+
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import selectors
+import shutil
+import subprocess
+import sys
+import time
+import uuid
+
+
+SPEC = importlib.util.spec_from_file_location("agentops_custody", Path(__file__).with_name("agentops-ci-custody.py"))
+custody = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(custody)
+delivery = custody.delivery
+MAX_SECONDS = 3600
+MAX_TRANSCRIPT = 64 * 1024 * 1024
+ENVIRONMENT = (
+    "GITHUB_ACTIONS", "GITHUB_REPOSITORY", "GITHUB_EVENT_NAME", "GITHUB_REF", "GITHUB_SHA",
+    "GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT", "GITHUB_EVENT_PATH", "GITHUB_WORKSPACE",
+    "RUNNER_TEMP", "AGENTOPS_CI_ROOT", "AGENTOPS_CI_ATTEMPT", "AGENTOPS_CI_MARKER",
+    "AGENTOPS_CI_APPROVAL_FILE", "AGENTOPS_CI_DIAGNOSTIC_MODE",
+    "AZURE_CONFIG_DIR", "AZD_CONFIG_DIR", "AZURE_TOKEN_CREDENTIALS",
+    "AZURE_CLIENT_ID", "AZURE_TENANT_ID", "AZURE_SUBSCRIPTION_ID", "AZURE_AI_PROJECT_ID",
+    "FOUNDRY_PROJECT_ENDPOINT", "FOUNDRY_MODEL_DEPLOYMENT", "AZURE_AI_FOUNDRY_PROJECT_ENDPOINT",
+    "AZURE_OPENAI_DEPLOYMENT", "AZURE_AI_MODEL_DEPLOYMENT_NAME",
+    "APPLICATIONINSIGHTS_CONNECTION_STRING", "AGENTOPS_APPLICATIONINSIGHTS_CONNECTION_STRING",
+    "APPLICATIONINSIGHTS_STATSBEAT_DISABLED_ALL", "APPLICATIONINSIGHTS_CONTROLPLANE_DISABLED",
+    "LAW_WORKSPACE_ID", "COPILOT_ALLOW_ALL", "COPILOT_AUTO_UPDATE",
+    "COPILOT_PROVIDER_TYPE", "COPILOT_PROVIDER_BASE_URL", "COPILOT_PROVIDER_MODEL_ID",
+    "COPILOT_PROVIDER_WIRE_MODEL", "COPILOT_PROVIDER_WIRE_API",
+    "COPILOT_PROVIDER_AZURE_API_VERSION", "COPILOT_PROVIDER_API_KEY",
+    "COPILOT_PROVIDER_BEARER_TOKEN", "COPILOT_PROVIDER_API_KEY_COMMAND", "COPILOT_PROVIDER_HEADERS",
+)
+TOOLS = {
+    "python3": ("--version",), "node": ("--version",), "copilot": ("--version",),
+    "az": ("version",), "azd": ("version",), "uv": ("--version",),
+}
+
+
+def docker(argv, **kwargs):
+    return subprocess.run(["docker", *argv], check=True, capture_output=True,
+                          timeout=kwargs.pop("timeout", 60), **kwargs)
+
+
+def mount(source, destination=None, *, writable=False):
+    source = Path(source)
+    delivery.require(source.is_absolute() and not source.is_symlink() and source.exists())
+    destination = str(destination or source)
+    delivery.require("," not in str(source) + destination and "\n" not in str(source) + destination)
+    return ["--mount", f"type=bind,source={source},target={destination}" +
+            ("" if writable else ",readonly")]
+
+
+def tool_cohort():
+    delivery.require(sys.platform == "linux")
+    # System code/libraries only; never /opt as a whole or any host home/cache.
+    paths = {Path(path) for path in (
+        "/usr/bin", "/usr/sbin", "/usr/lib", "/usr/lib64", "/usr/libexec", "/usr/share",
+        "/usr/local/bin", "/usr/local/lib", "/usr/local/share", "/etc/ssl/certs",
+        "/etc/ld.so.cache", "/etc/nsswitch.conf", "/opt/az",
+    ) if Path(path).exists()}
+    tools = {}
+    for name, arguments in TOOLS.items():
+        binary = shutil.which(name)
+        delivery.require(binary is not None)
+        resolved = Path(binary).resolve(strict=True)
+        if not any(resolved.is_relative_to(path) for path in paths):
+            if name in ("azd", "uv"):
+                paths.add(resolved)
+            else:
+                prefix = resolved.parent.parent
+                delivery.require(resolved.parent.name == "bin" and prefix.is_relative_to("/opt")
+                                 and prefix != Path("/opt") and len(prefix.parts) >= 3)
+                paths.add(prefix)
+        version = subprocess.run([str(resolved), *arguments], check=True, capture_output=True, timeout=30)
+        tools[name] = {
+            "path": str(resolved), "sha256": hashlib.sha256(resolved.read_bytes()).hexdigest(),
+            "version_sha256": hashlib.sha256(version.stdout).hexdigest(),
+        }
+    return sorted(paths), tools
+
+
+def child_environment(root, attempt, channel, tools):
+    env = {key: os.environ[key] for key in ENVIRONMENT if key in os.environ}
+    env.update(
+        HOME="/home/agent", TMPDIR="/tmp", PYTHONDONTWRITEBYTECODE="1",
+        PATH=":".join(dict.fromkeys([str(Path(tool["path"]).parent) for tool in tools.values()]
+                                    + ["/usr/local/bin", "/usr/bin", "/bin"])),
+        AGENTOPS_CI_ATTEMPT=attempt,
+        AGENTOPS_CI_WORKSPACE=channel.workspace,
+        AGENTOPS_CI_CUSTODY_TOKEN=channel.token,
+    )
+    delivery.require(env["AGENTOPS_CI_ROOT"] == str(root))
+    return env
+
+
+def scaffold(root, attempt, workspace):
+    """Prepare only one writable handoff/workspace; host records stay unmounted."""
+    inputs = root / "child-inputs"
+    delivery.mkdir(inputs, root)
+    for name in ("observations",):
+        delivery.mkdir(inputs / name, root)
+    delivery.write(inputs / "workspace-pointer", root, (workspace + "\n").encode())
+    delivery.mkdir(root / "workspaces" / workspace, root)
+    delivery.write(delivery.attempt_dir(root, attempt) / "workspace-pointer", root,
+                   (workspace + "\n").encode())
+    return inputs
+
+
+def build_envelope(root, attempt, image_tag, *, base="scratch"):
+    context = root / "container-build"
+    delivery.mkdir(context, root)
+    skeleton = context / "rootfs"
+    skeleton.mkdir(mode=0o700)
+    # Actual runner paths are retained inside the container, not redirected to
+    # host-visible parent directories. Only the mounts below carry data.
+    for path in (root, root / "attempts", root / "attempts" / attempt,
+                 root / "workspaces", root / "channel", root / "azure", root / "azd",
+                 Path("/home/agent"), Path("/tmp"), Path("/etc")):
+        (skeleton / str(path).lstrip("/")).mkdir(parents=True, exist_ok=True, mode=0o700)
+    workspace = delivery.read(root / "child-inputs/workspace-pointer", root).decode().strip()
+    (skeleton / str(root / "workspaces" / workspace).lstrip("/")).mkdir(mode=0o700)
+    for name, destination in (("bin", "usr/bin"), ("sbin", "usr/sbin"),
+                              ("lib", "usr/lib"), ("lib64", "usr/lib64")):
+        (skeleton / name).symlink_to(destination)
+    # No host account database is exposed or changed.
+    (skeleton / "etc/passwd").write_text(f"agent:x:{os.getuid()}:{os.getgid()}:CI:/home/agent:/bin/bash\n")
+    (skeleton / "etc/group").write_text(f"agent:x:{os.getgid()}:\n")
+    dockerfile = f"FROM {base}\nCOPY --chown={os.getuid()}:{os.getgid()} rootfs/ /\n"
+    delivery.write(context / "Dockerfile", root, dockerfile.encode())
+    try:
+        result = docker(["build", "--network=none", "--pull=false", "--tag", image_tag, str(context)], timeout=180)
+    except subprocess.CalledProcessError as failure:
+        delivery.write(root / "container-build.log", root, failure.stdout + failure.stderr)
+        raise
+    delivery.write(root / "container-build.log", root, result.stdout + result.stderr)
+    image = docker(["image", "inspect", "--format", "{{.Id}}", image_tag]).stdout.decode().strip()
+    delivery.require(delivery.re.fullmatch("sha256:[0-9a-f]{64}", image))
+    delivery.write(root / "container-image", root, (image + "\n").encode())
+    return image
+
+
+def container_arguments(root, attempt, image, env_file, inputs, paths, command, *, network="bridge"):
+    delivery.require(network in ("bridge", "none"))
+    args = [
+        "create", "--init", "--read-only", "--log-driver=none",
+        "--cap-drop=ALL", "--security-opt=no-new-privileges",
+        "--user", f"{os.getuid()}:{os.getgid()}", "--network", network,
+        "--pids-limit", "256", "--stop-timeout", "10",
+        "--tmpfs", f"/tmp:rw,nosuid,nodev,size=2g,mode=1777",
+        "--tmpfs", f"/home/agent:rw,nosuid,nodev,size=1g,mode=700,uid={os.getuid()},gid={os.getgid()}",
+        "--env-file", str(env_file), "--workdir", os.environ["GITHUB_WORKSPACE"],
+        "--label", "agentops-ci.run=" + os.environ["GITHUB_RUN_ID"],
+        "--label", "agentops-ci.attempt=" + os.environ["GITHUB_RUN_ATTEMPT"],
+    ]
+    for path in paths:
+        args += mount(path.resolve(strict=True), path)
+    args += mount(Path(os.environ["GITHUB_WORKSPACE"]))
+    # Bind only the allocated UUID, not its parent. A remove/recreate of this
+    # mount's contents cannot reach sibling host workspaces or host records.
+    workspace = delivery.read(inputs / "workspace-pointer", root).decode().strip()
+    args += mount(root / "workspaces" / workspace, writable=True)
+    args += mount(inputs, root / "attempts" / attempt, writable=True)
+    args += mount(inputs / "workspace-pointer", root / "attempts" / attempt / "workspace-pointer")
+    args += mount(root / "channel")
+    args += mount(root / "azure", writable=True)
+    args += mount(root / "azd")
+    args += mount(root / "owner-approval.json")
+    args += mount(Path(os.environ["GITHUB_EVENT_PATH"]))
+    args += [image, *command]
+    return args
+
+
+def checked_command(root, tools, command):
+    code = """import hashlib,json,os,signal,subprocess,sys
+from pathlib import Path
+os.umask(0o077)
+record=json.loads(Path(sys.argv[1]).read_text())
+flags={"python3":["--version"],"node":["--version"],"copilot":["--version"],"az":["version"],"azd":["version"],"uv":["--version"]}
+try:
+ for name,tool in record.items():
+  assert hashlib.sha256(Path(tool["path"]).read_bytes()).hexdigest()==tool["sha256"]
+  result=subprocess.run([tool["path"],*flags[name]],capture_output=True,check=True,timeout=30)
+  assert hashlib.sha256(result.stdout).hexdigest()==tool["version_sha256"]
+except Exception:
+ print("AGENTOPS_CI_ISOLATION=FAIL TOOL_COHORT",file=sys.stderr)
+ sys.exit(125)
+status=subprocess.call(sys.argv[2:])
+if status < 0:
+ os.kill(os.getpid(), -status)
+sys.exit(status)
+"""
+    return [tools["python3"]["path"], "-I", "-c", code, str(root / "tool-cohort.json"), *command]
+
+
+def remove_container(identifier):
+    delivery.require(delivery.re.fullmatch("[0-9a-f]{64}", identifier))
+    query = ["container", "ls", "--all", "--quiet", "--no-trunc", "--filter", f"id={identifier}"]
+    if docker(query).stdout.strip():
+        docker(["rm", "--force", identifier], timeout=30)
+    delivery.require(not docker(query).stdout.strip())
+
+
+def capture(identifier, channel, transcript, *, seconds=MAX_SECONDS):
+    """Only the host writes the transcript; child stdout is a Docker pipe."""
+    deadline, total, good = time.monotonic() + seconds, 0, True
+    with channel.listen() as server, open(transcript, "ab", buffering=0) as output:
+        delivery.file_info(output.fileno())
+        with subprocess.Popen(["docker", "start", "--attach", identifier],
+                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                              stdin=subprocess.DEVNULL, close_fds=True) as process:
+            with selectors.DefaultSelector() as selector:
+                selector.register(server, selectors.EVENT_READ, "receipt")
+                selector.register(process.stdout, selectors.EVENT_READ, "stdout")
+                try:
