+"""Synthetic host-custody regressions; no credentials or network calls."""
+
+import importlib.util
+import contextlib
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location("custody_reporter", ROOT / "scripts/agentops-ci-report.py")
+REPORTER = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(REPORTER)
+CUSTODY_SPEC = importlib.util.spec_from_file_location("unix_custody", ROOT / "scripts/agentops-ci-custody.py")
+CUSTODY = importlib.util.module_from_spec(CUSTODY_SPEC)
+CUSTODY_SPEC.loader.exec_module(CUSTODY)
+ISOLATION_SPEC = importlib.util.spec_from_file_location("docker_isolation", ROOT / "scripts/agentops-ci-isolation.py")
+ISOLATION = importlib.util.module_from_spec(ISOLATION_SPEC)
+ISOLATION_SPEC.loader.exec_module(ISOLATION)
+
+
+class HostCustodyTests(unittest.TestCase):
+    def setUp(self):
+        self.previous_umask = os.umask(0o077)
+        self.addCleanup(os.umask, self.previous_umask)
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name).resolve() / "agentops-ci-123-1"
+        self.public = Path(self.temp.name).resolve() / "agentops-ci-public-123-1"
+
+    def start(self):
+        REPORTER.initialize(self.root, self.public)
+        REPORTER.prepare(self.root, "primary")
+
+    def test_existing_public_destination_cannot_leave_retryable_skeleton(self):
+        self.public.mkdir(mode=0o700)
+        sentinel = self.public / "preserved"
+        sentinel.write_bytes(b"prior evidence")
+        with self.assertRaises((OSError, ValueError)):
+            REPORTER.initialize(self.root, self.public)
+        self.assertFalse(self.root.exists())
+        self.assertEqual(sentinel.read_bytes(), b"prior evidence")
+
+    def test_failed_partial_initialization_removes_only_new_owned_paths(self):
+        mkdir = REPORTER.mkdir
+
+        def fail(path, private=None):
+            if path == self.root / "workspaces":
+                raise OSError("synthetic allocation failure")
+            return mkdir(path, private)
+
+        with patch.object(REPORTER, "mkdir", side_effect=fail):
+            with self.assertRaises(OSError):
+                REPORTER.initialize(self.root, self.public)
+        self.assertFalse(self.root.exists())
+        self.assertFalse(self.public.exists())
+
+    def test_missing_or_replaced_state_is_not_retry_permission(self):
+        for relative in ("initialized.json", "attempts/primary", "workspaces"):
+            with self.subTest(relative=relative):
