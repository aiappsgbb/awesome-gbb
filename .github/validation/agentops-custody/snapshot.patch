@@ -0,0 +1,177 @@
+#!/usr/bin/env python3
+"""Bounded private Unix receipt handoff; ACK is custody, not native authenticity."""
+
+from contextlib import contextmanager
+import hmac
+import importlib.util
+import json
+import os
+from pathlib import Path
+import secrets
+import socket
+import stat
+import sys
+import time
+
+
+SPEC = importlib.util.spec_from_file_location("custody_delivery", Path(__file__).with_name("agentops-ci-report.py"))
+delivery = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(delivery)
+LIMIT = 2048
+TIMEOUT = 3
+MAX_CONNECTIONS = 16
+
+
+def packet(stream, *, deadline=None):
+    deadline = time.monotonic() + TIMEOUT if deadline is None else deadline
+    raw = bytearray()
+    while b"\n" not in raw:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise TimeoutError("receipt deadline expired")
+        stream.settimeout(remaining)
+        part = stream.recv(min(512, LIMIT + 1 - len(raw)))
+        delivery.require(part)
+        raw.extend(part)
+        delivery.require(len(raw) <= LIMIT)
+    if time.monotonic() >= deadline:
+        raise TimeoutError("receipt deadline expired")
+    delivery.require(raw.endswith(b"\n") and raw.count(b"\n") == 1)
+    return delivery.parse(raw)
+
+
+class Custody:
+    def __init__(self, root, attempt, workspace):
+        delivery.require(attempt in ("primary", "retry"))
+        delivery.require(delivery.re.fullmatch("[0-9a-f]{32}", workspace))
+        self.root, self.attempt, self.workspace = root, attempt, workspace
+        self.token = secrets.token_hex(32)
+        self.binding = {
+            "run_id": os.environ["GITHUB_RUN_ID"],
+            "run_attempt": os.environ["GITHUB_RUN_ATTEMPT"],
+            "attempt": attempt, "workspace": workspace,
+        }
+        self.target = root / "custody"
+        self.channel = root / "channel"
+        self.socket_path = self.channel / "receipt.sock"
+        self.connections = 0
+        self.accepted = set()
+
+    @contextmanager
+    def listen(self):
+        delivery.mkdir(self.target, self.root)
+        # Linux sockaddr_un is limited to 108 bytes. Use a short relative bind,
+        # while anchoring the private parent with a retained no-follow dirfd.
+        with delivery.directory(self.channel, self.root) as parent:
+            delivery.require(not os.listdir(parent))
+            endpoint = f"/proc/self/fd/{parent}/receipt.sock"
+            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
+                server.bind(endpoint)
+                os.chmod("receipt.sock", 0o600, dir_fd=parent)
+                identity = os.stat("receipt.sock", dir_fd=parent, follow_symlinks=False)
+                server.listen(1)
+                server.setblocking(False)
+                try:
+                    yield server
+                finally:
+                    current = os.stat("receipt.sock", dir_fd=parent, follow_symlinks=False)
+                    delivery.require(stat.S_ISSOCK(current.st_mode) and
+                                     (current.st_dev, current.st_ino) == (identity.st_dev, identity.st_ino))
+                    os.unlink("receipt.sock", dir_fd=parent)
+
+    def receive(self, server, *, deadline=None):
+        stream, _ = server.accept()
+        with stream:
+            expires = time.monotonic() + TIMEOUT
+            if deadline is not None:
+                expires = min(expires, deadline)
+            try:
+                self.connections += 1
+                delivery.require(self.connections <= MAX_CONNECTIONS)
+                value = packet(stream, deadline=expires)
+                delivery.require(isinstance(value, dict) and
+                                 set(value) == {"token", "binding", "kind", "payload"})
+                delivery.require(isinstance(value["token"], str) and
+                                 hmac.compare_digest(value["token"], self.token))
+                delivery.require(value["binding"] == self.binding)
+                kind, payload = value["kind"], value["payload"]
+                delivery.require(kind in ("create_intent", "identity") and kind not in self.accepted)
+                if kind == "create_intent":
+                    delivery.require(payload == {} and not self.accepted)
+                else:
+                    delivery.require(self.accepted == {"create_intent"})
+                    delivery.require(isinstance(payload, dict) and set(payload) == {"name", "version"})
+                    delivery.require(payload["name"] == "ci-smoke-agentops-pa-" + self.workspace)
+                    delivery.require(isinstance(payload["version"], str) and
+                                     delivery.re.fullmatch("[A-Za-z0-9._-]{1,128}", payload["version"]))
+                receipt = {
+                    "schema_version": 1, "provenance": "untrusted_agent_writable",
+                    "binding": self.binding, "kind": kind, "payload": payload,
+                }
+                delivery.write_observation(self.target / (kind + ".json"), self.root, receipt)
+                with delivery.directory(self.target, self.root) as parent:
+                    os.fsync(parent)
+                self.accepted.add(kind)
+                remaining = expires - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError("receipt deadline expired")
+                stream.settimeout(remaining)
+                stream.sendall(b"ACK\n")
+                return True
+            except (OSError, ValueError, TypeError, RecursionError):
+                # A reject is deliberately payload-free and cannot authorize replay.
+                try:
+                    stream.setblocking(False)
+                    stream.sendall(b"REJECT\n")
+                except OSError:
+                    pass
+                return False
+
+
+def submit(kind, payload):
+    """Called synchronously on the original CREATE path, never as later recovery."""
+    root, _ = delivery.roots()
+    attempt = os.environ["AGENTOPS_CI_ATTEMPT"]
+    workspace = delivery.workspace_path(root, attempt).name
+    value = {
+        "token": os.environ["AGENTOPS_CI_CUSTODY_TOKEN"],
+        "binding": {
+            "run_id": os.environ["GITHUB_RUN_ID"],
+            "run_attempt": os.environ["GITHUB_RUN_ATTEMPT"],
+            "attempt": attempt, "workspace": workspace,
+        },
+        "kind": kind, "payload": payload,
+    }
+    raw = (json.dumps(value, separators=(",", ":"), allow_nan=False) + "\n").encode()
+    delivery.require(len(raw) <= LIMIT)
+    # The endpoint is fixed. Neither payload nor environment may supply a path.
+    with delivery.directory(root / "channel", root) as parent:
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
+            stream.settimeout(TIMEOUT)
+            stream.connect(f"/proc/self/fd/{parent}/receipt.sock")
+            stream.sendall(raw)
+            ack = bytearray()
+            while len(ack) < 4:
+                part = stream.recv(4 - len(ack))
+                delivery.require(part)
+                ack.extend(part)
+            delivery.require(ack == b"ACK\n")
+
+
+def create_and_record(create_version, **kwargs):
+    """Do not return native success until the original identity is in custody."""
+    root, _ = delivery.roots()
+    attempt = os.environ["AGENTOPS_CI_ATTEMPT"]
+    workspace = delivery.workspace_path(root, attempt)
+    delivery.require(kwargs.get("agent_name") == "ci-smoke-agentops-pa-" + workspace.name)
+    submit("create_intent", {})
+    agent = create_version(**kwargs)
+    identity = {"name": agent.name, "version": agent.version}
+    submit("identity", identity)
+    delivery.write_observation(workspace / "agent-identity.json", root, identity)
+    return agent
+
+
+if __name__ == "__main__":
+    print("AGENTOPS_CI_CUSTODY=FAIL DIRECT_INVOCATION")
+    sys.exit(1)
