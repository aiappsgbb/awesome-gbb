+    def test_slow_drip_has_absolute_deadline_and_capture_finalizers_run(self):
+        channel = self.channel()
+        raw = json.dumps(self.request(channel)).encode() + b"\n"
+        clock, timeouts, received = [0.0], [], []
+        left, right = socket.socketpair()
+        with left, right:
+            left.sendall(raw)
+            left.shutdown(socket.SHUT_WR)
+            def recv(size):
+                part = right.recv(min(size, 1))
+                clock[0] += 0.75
+                received.append(part)
+                return part
+            def settimeout(value):
+                timeouts.append(value)
+                right.settimeout(value)
+            with patch.object(CUSTODY, "time", SimpleNamespace(monotonic=lambda: clock[0]),
+                              create=True):
+                with self.assertRaises(TimeoutError):
+                    CUSTODY.packet(SimpleNamespace(recv=recv, settimeout=settimeout))
+        self.assertEqual(clock[0], CUSTODY.TIMEOUT)
+        self.assertEqual(timeouts, [3.0, 2.25, 1.5, 0.75])
+        self.assertEqual(len(received), 4)
+
+        native_popen = subprocess.Popen
+        processes, finalized = [], []
+        server, ready = socket.socketpair()
+        sender, incoming = socket.socketpair()
+        with server, ready, sender, incoming:
+            ready.sendall(b"!")
+            sender.sendall(b"{")
+            @contextlib.contextmanager
+            def listen():
+                try:
+                    yield server
+                finally:
+                    finalized.append("host")
+            def accept():
+                server.recv(1)
+                return incoming, None
+            receive = channel.receive
+            def receive_ready(_server, **kwargs):
+                return receive(SimpleNamespace(accept=accept), **kwargs)
+            def popen(args, **kwargs):
+                process = native_popen([sys.executable, "-c", "import time; time.sleep(20)"], **kwargs)
+                processes.append(process)
+                return process
+            def docker(args, **kwargs):
+                self.assertEqual(args[0], "stop")
+                finalized.append("child")
+                processes[0].terminate()
+                return SimpleNamespace(stdout=b"")
+            before = time.monotonic()
+            with patch.object(channel, "listen", side_effect=listen), \
+                    patch.object(channel, "receive", side_effect=receive_ready), \
+                    patch.object(ISOLATION.subprocess, "Popen", side_effect=popen), \
